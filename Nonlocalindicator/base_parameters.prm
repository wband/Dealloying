subsection Rectangular mesh
  set x size = __LX__
  set y size = 1.0
  set periodic x = false
  set periodic y = false
  set periodic z = false
  set x subdivisions = 64
  set y subdivisions = 1
end

set global refinement = 1
set mesh adaptivity   = false

set time step = __DT__
set number steps = __MAXITS__

subsection output
  set condition = EQUAL_SPACING
  set number = 20
  set file type = vtu
end

subsection boundary conditions: 0
  set variables = x2
  set conditions = Dirichlet, Natural, Natural, Natural
end

set Model constant deltaG0 = 1.0, DOUBLE
set Model constant D1 = 1, DOUBLE
set Model constant D1s = 0.0, DOUBLE
set Model constant D2 = 500.0, DOUBLE
set Model constant j0 = 1.1e-2, DOUBLE
set Model constant l_int = __L_INT__, DOUBLE
set Model constant x1_init = 0.6, DOUBLE
set Model constant x2_init = 0.01, DOUBLE
set Model constant epsilon = __EPS__, DOUBLE
set Model constant zeta = 0.0, DOUBLE
set Model constant int_delta = __DEL__, INT
set Model constant x_in_rxn = FALSE, BOOL
set Model constant tavg_denom = __TD__, INT
