subsection Rectangular mesh
  set x size = 0.625
  set y size = 80.0
  set periodic x = false
  set periodic y = false
  set periodic z = false
  set x subdivisions = 1
  set y subdivisions = 128
end

set global refinement = 2
set mesh adaptivity   = false

set time step = 5e-6
set number steps = 1000000

subsection output
  set condition = EQUAL_SPACING
  set number = 10
  set file type = vtu
end

subsection boundary conditions: 0
  set variables = x2
  set conditions = Natural, Natural, Natural, Dirichlet
end

set Model constant deltaG0 = 0.0, DOUBLE
set Model constant D1 = 1.0, DOUBLE
set Model constant D1s = 0.0, DOUBLE
set Model constant D2 = 50.0, DOUBLE
set Model constant j0 = 1.1e-2, DOUBLE
set Model constant l_int = 2.0, DOUBLE
set Model constant x1_init = 0.2, DOUBLE
set Model constant x2_init = 0.01, DOUBLE
set Model constant epsilon = 1e-3, DOUBLE
set Model constant int_delta = 1, INT
set Model constant well_type = 0, INT
set Model constant x_in_rxn = 0, INT
set Model constant constrain_x = TRUE, BOOL
set Model constant amplitude = 0.25, DOUBLE


subsection input file: 0
  set file name = dealloy_n_p1D.in
  set format = binary
  set file variables = n
  set simulation variables = n
  set x data points = 5
  set y data points  = 513
  set z data points  = 1
end

subsection input file: 1
  set file name = dealloy_x1_p1D.in
  set format = binary
  set file variables = x1
  set simulation variables = x1
  set x data points = 5
  set y data points  = 513
  set z data points  = 1
end

subsection input file: 2
  set file name = dealloy_x2_p1D.in
  set format = binary
  set file variables = x2
  set simulation variables = x2
  set x data points = 5
  set y data points  = 513
  set z data points  = 1
end
